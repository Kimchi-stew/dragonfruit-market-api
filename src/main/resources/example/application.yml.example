spring:
  application:
    name: dragon_fruit_market

  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update          # 개발중 임시 설정 (개발 완료 후 none 으로 바꿀 예정)
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect

  profiles:
    active: local               # 실행 환경에 따라 local 또는 prod 로 변경

  security:
    oauth2:
      client:
        registration:
          naver:
            client-id: 네이버_클라이언트_ID
            client-secret: 네이버_클라이언트_시크릿
            scope:
              - email
            client-name: Naver
            authorization-grant-type: authorization_code
            redirect-uri: "https://your-domain.com/login/oauth2/code/naver"
          kakao:
            client-id: 카카오_REST_API_키
            client-secret: 카카오_클라이언트_시크릿
            scope:
              - account_email
            authorization-grant-type: authorization_code
            redirect-uri: "https://your-domain.com/login/oauth2/code/kakao"
            client-name: Kakao
            client-authentication-method: client_secret_post
        provider:
          naver:
            authorization-uri: https://nid.naver.com/oauth2.0/authorize
            token-uri: https://nid.naver.com/oauth2.0/token
            user-info-uri: https://openapi.naver.com/v1/nid/me
            user-name-attribute: response
          kakao:
            authorization-uri: https://kauth.kakao.com/oauth/authorize
            token-uri: https://kauth.kakao.com/oauth/token
            user-info-uri: https://kapi.kakao.com/v2/user/me
            user-name-attribute: id

server:
  port: 8282
  servlet:
    context-path: /api

springdoc:
  api-docs:
    path: /v3/api-docs
  swagger-ui:
    path: /swagger-ui.html

logging:
  level:
    org.springframework.web: DEBUG

aws:
  access-key: ${AWS_ACCESS_KEY}
  secret-key: ${AWS_SECRET_KEY}
  send-mail-from: ${ADMIN_EMAIL}
  region: ${AWS_REGION}
  s3:
    bucket: ${AWS_S3_BUCKET}
